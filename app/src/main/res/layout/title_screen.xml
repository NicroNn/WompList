<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp">

        <ImageView
            android:id="@+id/posterImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/womp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attack on Titan"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@android:drawable/btn_star_big_on"
                    app:tint="?android:attr/colorPrimary" />

                <TextView
                    android:id="@+id/ratingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="8.5/10"
                    android:textColor="?android:attr/colorPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/yearText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="2013"
                    android:textColor="?android:attr/colorPrimary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/watchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="?android:attr/colorPrimary"
            android:textColor="?attr/colorOnBackground"
            android:text="@string/app_name"
            android:textAllCaps="false"
            app:cornerRadius="25dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addToListButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/add_to_list"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnSurface"
            app:cornerRadius="25dp"
            app:strokeColor="?android:attr/colorPrimary" />
    </LinearLayout>

    <!-- Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:tabTextColor="?attr/colorOnBackground"
        app:tabSelectedTextColor="?android:attr/colorPrimary"
        app:tabIndicatorColor="?android:attr/colorPrimary"
        app:tabMode="fixed"
        app:tabPaddingStart="8dp"
        app:tabPaddingEnd="8dp"
        app:tabGravity="fill" />

    <!-- Page content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:text="@string/about"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="4dp"
                android:layout_height="30dp"
                android:layout_width="500dp"/>

            <TextView
                android:text="Several hundred years ago, humans were nearly exterminated by giants..."
                android:textColor="?attr/colorOnBackground"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:layout_height="30dp"
                android:layout_width="500dp"/>

            <TextView
                android:text="@string/genres"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="4dp"
                android:layout_height="30dp"
                android:layout_width="500dp"/>

            <TextView
                android:text="Action, Drama, Thriller"
                android:textColor="?attr/colorOnBackground"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:layout_height="30dp"
                android:layout_width="500dp"/>

            <TextView
                android:text="@string/episodes"
                android:textColor="?attr/colorOnBackground"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_height="30dp"
                android:layout_width="500dp"/>

            <TextView
                android:text="@string/episodes_count"
                android:textColor="?attr/colorOnBackground"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:layout_height="30dp"
                android:layout_width="500dp"/>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
