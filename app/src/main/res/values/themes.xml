<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.WompList" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowAnimationStyle">@style/WompListWindowAnimation</item>
    </style>

    <style name="WompListWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="Theme.WompList.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/womp</item>
        <item name="postSplashScreenTheme">@style/Theme.WompList</item>
    </style>
</resources>